    ring = (xhci_trb_t *)state->bt_acl_in_ring.cpu;
    ring[index].parameter = xhci_dma_address(&state->bt_acl_in_buffer.mapping);
    ring[index].status = PAGE_SIZE;
    ring[index].control = (XHCI_NORMAL_TRB_TYPE << XHCI_TRB_TYPE_SHIFT) |
