    xhci_dma_page_t bt_acl_in_buffer; \
    xhci_dma_page_t bt_acl_out_ring; \
    xhci_dma_page_t bt_acl_out_buffer; \
    xhci_dma_page_t hub_ring; \
    xhci_dma_page_t hub_report; \
    uint8_t device_slot; \
