typedef struct xhci_device_context {
    XHCI_DEVICE_FIELDS
} xhci_device_context_t;

/*
 * xHCI V3 Slot Table.
 *
 * Only introduce the storage here.
 * Migration happens in later steps.
 */

#define XHCI_MAX_SLOT_TABLE 256U


typedef struct xhci_slot_device {

    bool used;

    uint8_t slot_id;

    uint8_t speed;

    uint8_t device_class;

    uint8_t device_protocol;


    uint8_t parent_slot;

    uint8_t parent_port;

    uint8_t root_port;


    uint32_t route_string;


    uint8_t tt_slot;

    uint8_t tt_port;

    bool tt_multi;


    bool is_hub;

    uint8_t hub_port_count;

    uint8_t hub_protocol;


    /*
     * Downstream device slots.
     *
     * Index:
     *   port number - 1
     *
     * Value:
     *   child Slot ID
     */
    uint8_t child_slots[16];


    xhci_device_context_t context;


    /*
     * V3.6.7 SLOT RUNTIME LOCATION
     *
     * Slot ID remains the permanent hardware identity.
     *
     * The legacy inventory is temporarily retained only as
     * context storage.  Slot Table records its exact index,
     * therefore event paths no longer scan inventory[].
     */
    bool runtime_in_inventory;

    uint32_t inventory_index;

} xhci_slot_device_t;


static xhci_slot_device_t
g_xhci_slot_devices[
    XHCI_MAX_SLOT_TABLE]
    __attribute__((used));




/*
 * V3.8.2 INVENTORY SLOT INDEX
 *
 * inventory[] is no longer the authoritative device context store.
 *
 * slot_id identifies the real object:
 *
 *     g_xhci_slot_devices[slot_id]
 *
 * context remains temporarily as a compatibility shadow for the
 * Hub/BT/Audio migration.  It will be removed in a later V3.8 step.
 */
typedef struct xhci_inventory_entry {
    uint8_t slot_id;

    uint8_t kind;

    bool valid;

    xhci_device_context_t context;
} xhci_inventory_entry_t;

typedef struct xhci_state {
    const pci_device_t *pci;
    volatile uint8_t *mmio;
    uint64_t mmio_span;
    uint32_t operational_offset;
    uint32_t runtime_offset;
    uint32_t doorbell_offset;
    uint32_t max_slots;
    uint32_t max_ports;
    uint32_t context_size;
    uint32_t command_index;
    uint8_t command_cycle;
    uint32_t event_index;
    uint8_t event_cycle;
    xhci_dma_page_t dcbaa;
    xhci_dma_page_t command_ring;
    xhci_dma_page_t event_ring;
    xhci_dma_page_t erst;
    union {
        xhci_device_context_t device;
        struct { XHCI_DEVICE_FIELDS };
    };
    xhci_inventory_entry_t inventory[XHCI_MAX_USB_INVENTORY];
    uint32_t inventory_count;
    /* 同步控制传输期间到达的异步事件暂存于此，避免被等待循环丢弃。 */
    xhci_trb_t deferred_events[XHCI_DEFERRED_EVENT_COUNT];
    uint32_t deferred_event_head;
    uint32_t deferred_event_tail;
    uint32_t deferred_event_count;
    spinlock_t event_lock;
    uint8_t irq_vector;
    bool initialized;
} xhci_state_t;

/*
 * V3.8.1 SLOT CONTEXT OWNER
 *
 * All runtime code must resolve a device by Slot ID.
 *
 * Today the actual mutable context can still live in:
 *
 *      state->device
 *
 * or:
 *
 *      inventory[index].context
 *
 * Later V3.8 removes inventory context storage completely.
 *
 * Callers must therefore stop knowing where the context lives.
 */
/*
 * V3.8.1 / V3.8.2 SLOT CONTEXT OWNER
 *
 * Slot Table is now the canonical context for inactive devices.
 *
 * state->device remains a temporary active/working context until
 * the final active-device migration is completed.
 */
static xhci_device_context_t *
xhci_slot_context_owner(
    xhci_state_t *state,
    uint8_t slot)
{
    if(state == 0 ||
       slot == 0U)
    {
        return 0;
    }


    xhci_slot_device_t *slot_dev =
        &g_xhci_slot_devices[
            slot];


    if(!slot_dev->used)
    {
        return 0;
    }


    /*
     * Active working copy.
     */
    if(state->device.device_slot ==
       slot)
    {
        return
            &state->device;
    }


    /*
     * Inactive device:
     *
     * inventory[] proves that this Slot is parked, but the actual
     * mutable context is now Slot Table context.
     */
    if(slot_dev->
           runtime_in_inventory)
    {
        uint32_t index =
            slot_dev->
                inventory_index;


        if(index >=
           state->inventory_count)
        {
            return 0;
        }


        xhci_inventory_entry_t *entry =
            &state->inventory[
                index];


        if(!entry->valid ||
           entry->slot_id != slot)
        {
            return 0;
        }


        if(slot_dev->
               context.device_slot !=
           slot)
        {
            return 0;
        }


        return
            &slot_dev->context;
    }


    return 0;
}



/*
 * Synchronize the Slot Table mirror after the real owner changes.
 *
 * Later, when Slot Table itself becomes the owner, this function
 * becomes unnecessary and can be removed.
 */
static void
xhci_slot_context_sync(
    xhci_state_t *state,
    uint8_t slot)
{
    if(slot == 0U)
    {
        return;
    }


    xhci_device_context_t *owner =
        xhci_slot_context_owner(
            state,
            slot);


    if(owner == 0 ||
       owner->device_slot !=
           slot)
    {
        return;
    }


    g_xhci_slot_devices[
        slot].context =
            *owner;
}


#undef XHCI_DEVICE_FIELDS

static xhci_state_t g_xhci;

/*
 * V3.7.7 BT SLOT TRANSPORT
 *
 * Bluetooth Core callbacks must identify a USB device by its
 * permanent xHCI Slot ID, never by whichever context happens
 * to be installed in state->device.
 */
typedef struct xhci_bt_transport {
    xhci_state_t *state;
    uint8_t slot;
} xhci_bt_transport_t;


static xhci_bt_transport_t
g_xhci_bt_transports[
    XHCI_MAX_SLOT_TABLE];


static uint32_t g_xhci_error;
