#include <stdint.h>
#include <stdbool.h>


#include <usb/hub.h>


#define USB_MAX_HUBS 256


static usb_hub_t
usb_hubs[
    USB_MAX_HUBS];



usb_hub_t *
usb_hub_get(
    uint8_t slot)
{
    if(slot==0)
    {
        return 0;
    }


    if(!usb_hubs[slot].used)
    {
        return 0;
    }


    return
        &usb_hubs[slot];
}



bool
usb_hub_init(
    uint8_t slot,
    uint8_t ports)
{
    if(slot==0)
    {
        return false;
    }


    usb_hub_t *hub =
        &usb_hubs[slot];


    __builtin_memset(
        hub,
        0,
        sizeof(*hub));


    hub->used=true;

    hub->slot_id=slot;


    if(ports >
       USB_HUB_MAX_PORTS)
    {
        ports=USB_HUB_MAX_PORTS;
    }


    hub->port_count=ports;


    return true;
}



void
usb_hub_port_connect(
    uint8_t hub_slot,
    uint8_t port,
    uint8_t child_slot)
{
    usb_hub_t *hub =
        usb_hub_get(
            hub_slot);


    if(!hub)
    {
        return;
    }


    if(port==0 ||
       port>USB_HUB_MAX_PORTS)
    {
        return;
    }


    hub->child_slots[
        port-1]=child_slot;
}
