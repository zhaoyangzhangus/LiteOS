#ifndef LITEOS_BLEND2D_CXX_TUPLE_H
#define LITEOS_BLEND2D_CXX_TUPLE_H

#include <type_traits>
#include <utility>

namespace std {

template<typename First, typename Second>
struct tuple {
  First first;
  Second second;

  constexpr bool operator<(const tuple &other) const noexcept {
    return first < other.first ||
           (!(other.first < first) && second < other.second);
  }
};

template<typename First, typename Second>
constexpr tuple<decay_t<First>, decay_t<Second>> make_tuple(
    First &&first, Second &&second) {
  return {forward<First>(first), forward<Second>(second)};
}

} // namespace std

#endif
