#ifndef LITEOS_BLEND2D_CXX_ALGORITHM_H
#define LITEOS_BLEND2D_CXX_ALGORITHM_H

#include <stddef.h>

namespace std {

template<typename Iterator, typename Value, typename Compare>
Iterator lower_bound(Iterator first, Iterator last, const Value &value,
                     Compare compare) {
  size_t count = (size_t)(last - first);
  while (count != 0U) {
    size_t step = count / 2U;
    Iterator middle = first + step;
    if (compare(*middle, value)) {
      first = middle + 1U;
      count -= step + 1U;
    } else {
      count = step;
    }
  }
  return first;
}

template<typename T>
constexpr const T &min(const T &left, const T &right) noexcept {
  return right < left ? right : left;
}

template<typename T>
constexpr const T &max(const T &left, const T &right) noexcept {
  return left < right ? right : left;
}

} // namespace std

#endif
