#ifndef LITEOS_BLEND2D_CXX_CMATH_H
#define LITEOS_BLEND2D_CXX_CMATH_H

#include <math.h>

#undef fpclassify
#undef isfinite
#undef isinf
#undef isnan
#undef isnormal
#undef signbit
#undef isgreater
#undef isgreaterequal
#undef isless
#undef islessequal
#undef islessgreater
#undef isunordered

namespace std {

static inline bool isnan(float value) noexcept { return __builtin_isnan(value); }
static inline bool isnan(double value) noexcept { return __builtin_isnan(value); }
static inline bool isnan(long double value) noexcept { return __builtin_isnan(value); }
static inline bool isinf(float value) noexcept { return __builtin_isinf(value); }
static inline bool isinf(double value) noexcept { return __builtin_isinf(value); }
static inline bool isinf(long double value) noexcept { return __builtin_isinf(value); }
static inline bool isfinite(float value) noexcept { return __builtin_isfinite(value); }
static inline bool isfinite(double value) noexcept { return __builtin_isfinite(value); }
static inline bool isfinite(long double value) noexcept { return __builtin_isfinite(value); }
static inline float copysign(float value, float sign) noexcept { return __builtin_copysignf(value, sign); }
static inline double copysign(double value, double sign) noexcept { return __builtin_copysign(value, sign); }
static inline long double copysign(long double value, long double sign) noexcept { return __builtin_copysignl(value, sign); }
static inline float fmod(float left, float right) noexcept { return __builtin_fmodf(left, right); }
static inline double fmod(double left, double right) noexcept { return __builtin_fmod(left, right); }
static inline long double fmod(long double left, long double right) noexcept { return __builtin_fmodl(left, right); }
static inline float floor(float value) noexcept { return __builtin_floorf(value); }
static inline double floor(double value) noexcept { return __builtin_floor(value); }
static inline long double floor(long double value) noexcept { return __builtin_floorl(value); }
static inline float ceil(float value) noexcept { return __builtin_ceilf(value); }
static inline double ceil(double value) noexcept { return __builtin_ceil(value); }
static inline long double ceil(long double value) noexcept { return __builtin_ceill(value); }
static inline float trunc(float value) noexcept { return __builtin_truncf(value); }
static inline double trunc(double value) noexcept { return __builtin_trunc(value); }
static inline long double trunc(long double value) noexcept { return __builtin_truncl(value); }
static inline float nearbyint(float value) noexcept { return __builtin_nearbyintf(value); }
static inline double nearbyint(double value) noexcept { return __builtin_nearbyint(value); }
static inline long double nearbyint(long double value) noexcept { return __builtin_nearbyintl(value); }

} // namespace std

#endif
