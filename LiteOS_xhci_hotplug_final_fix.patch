diff --git a/kernel/drivers/usb/xhci.c b/kernel/drivers/usb/xhci.c
--- a/kernel/drivers/usb/xhci.c
+++ b/kernel/drivers/usb/xhci.c
@@
+/*
+ * Hotplug topology fix:
+ *
+ * Slot Table is the canonical topology source.
+ * parent->child_slots[] is only a repairable cache.
+ */
+
+static bool xhci_find_hub_child(
+    uint8_t parent_slot,
+    uint8_t parent_port,
+    uint8_t *child_slot)
+{
+    if(child_slot == 0 ||
+       parent_slot == 0 ||
+       parent_port == 0)
+    {
+        return false;
+    }
+
+    *child_slot = 0U;
+
+    xhci_slot_device_t *parent =
+        &g_xhci_slot_devices[parent_slot];
+
+    if(parent->used &&
+       parent_port <= 16U)
+    {
+        uint8_t slot =
+            parent->child_slots[parent_port - 1U];
+
+        if(slot != 0U)
+        {
+            xhci_slot_device_t *child =
+                &g_xhci_slot_devices[slot];
+
+            if(child->used &&
+               child->context.device_slot == slot &&
+               child->parent_slot == parent_slot &&
+               child->parent_port == parent_port)
+            {
+                *child_slot = slot;
+                return true;
+            }
+        }
+    }
+
+    for(uint32_t slot = 1U;
+        slot < XHCI_MAX_SLOT_TABLE;
+        ++slot)
+    {
+        xhci_slot_device_t *child =
+            &g_xhci_slot_devices[slot];
+
+        if(!child->used ||
+           child->context.device_slot != slot)
+        {
+            continue;
+        }
+
+        if(child->parent_slot == parent_slot &&
+           child->parent_port == parent_port)
+        {
+            if(parent->used &&
+               parent_port <= 16U)
+            {
+                parent->child_slots[parent_port - 1U] =
+                    (uint8_t)slot;
+            }
+
+            *child_slot = (uint8_t)slot;
+            return true;
+        }
+    }
+
+    return false;
+}
+
+/*
+ * Move parent-child cache update from enumeration stage
+ * to publication stage.
+ */
+
+/*
+ * In xhci_enumerate_device():
+ *
+ * Remove:
+ *
+ * parent_dev->child_slots[parent_port-1U] = slot;
+ *
+ */
+
+/*
+ * In xhci_publish_working_device(), after Slot.context
+ * becomes valid:
+ */
+
+if(published->parent_slot != 0U &&
+   published->parent_port != 0U &&
+   published->parent_port <= 16U)
+{
+    xhci_slot_device_t *parent =
+        &g_xhci_slot_devices[published->parent_slot];
+
+    if(parent->used)
+    {
+        parent->child_slots[
+            published->parent_port - 1U] =
+                published->slot_id;
+    }
+}
+
+/*
+ * In xhci_remove_device_subtree():
+ * unlink cache before freeing Slot.
+ */
+
+if(slot_dev->parent_slot != 0U &&
+   slot_dev->parent_port != 0U)
+{
+    xhci_slot_device_t *parent =
+        &g_xhci_slot_devices[slot_dev->parent_slot];
+
+    if(parent->used &&
+       slot_dev->parent_port <= 16U &&
+       parent->child_slots[slot_dev->parent_port-1U] == slot)
+    {
+        parent->child_slots[slot_dev->parent_port-1U] = 0U;
+    }
+}
