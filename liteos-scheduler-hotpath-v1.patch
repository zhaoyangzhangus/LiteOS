+     * Lockless read-mostly snapshot:
+     *   low  32 bits: queued runnable threads (queue.nr_running)
+     *   high 32 bits: total schedulable load (queued + current when runnable)
+     *
+     * Writers already serialize through queue.lock.  Publishing this snapshot
+     * is only a release store (a normal MOV on x86-64), while load balancing,
+     * tick and idle polling no longer need to acquire a remote runqueue lock.
+     */
+    atomic_uint_fast64_t queue_snapshot;

     /* Threads that left their execution stack and await final reclamation. */
