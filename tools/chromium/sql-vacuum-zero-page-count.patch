diff --git a/net/disk_cache/sql/sql_persistent_store_backend.cc b/net/disk_cache/sql/sql_persistent_store_backend.cc
--- a/net/disk_cache/sql/sql_persistent_store_backend.cc
+++ b/net/disk_cache/sql/sql_persistent_store_backend.cc
@@ -3394,8 +3394,18 @@ SqlPersistentStore::Backend::MaybeRunIncrementalVacuumInternal(
   }

   const int freelist_count = GetFreelistCount();
+  // An empty freelist requires no work. Check it before reading the page-count
+  // feature parameter: the native platform may supply zero through a field-trial override.
+  if (freelist_count <= 0) {
+    return Error::kOk;
+  }
   const int page_count_to_vacuum =
       net::features::kSqlDiskCacheIncrementalVacuumPageCount.Get();
+  // A zero/negative override disables this optional maintenance pass rather
+  // than reaching the division below with an invalid divisor.
+  if (page_count_to_vacuum <= 0) {
+    return Error::kIncrementalVacuumDisabled;
+  }
   const int iterations =
       (freelist_count + page_count_to_vacuum - 1) / page_count_to_vacuum;

