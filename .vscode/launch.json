{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "LiteOS: Kernel debug (F5 auto detect)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-refactor/esp/EFI/LITEOS/kernel.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "miDebuggerServerAddress": "127.0.0.1:1234",
            "preLaunchTask": "LiteOS: start QEMU debug (auto)",
            "postDebugTask": "LiteOS: stop QEMU debug (auto)",
            "stopAtEntry": false,
            "windows": {
                "miDebuggerPath": "C:\\Program Files\\w64devkit\\bin\\gdb.exe"
            },
            "logging": {
                "engineLogging": true,
                "trace": true,
                "traceResponse": true
            },
            "setupCommands": [
                {
                    "description": "Disable GDB pagination",
                    "text": "set pagination off",
                    "ignoreFailures": true
                },
                {
                    "description": "Show the next instruction",
                    "text": "set disassemble-next-line on",
                    "ignoreFailures": true
                }
            ],
            "sourceFileMap": {}
        }
    ]
}
