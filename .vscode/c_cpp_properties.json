{
    "configurations": [
        {
            "name": "LiteOS (WSL)",
            "compilerPath": "gcc",
            "intelliSenseMode": "linux-gcc-x64",
            "cStandard": "c11",
            "cppStandard": "c++11",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/kernel",
                "${workspaceFolder}/build/generated"
            ],
            "defines": [
                "LITEOS_KERNEL_BUILD"
            ],
            "compilerArgs": [
                "-ffreestanding",
                "-fno-builtin",
                "-fno-stack-protector",
                "-fno-stack-check",
                "-fno-pic",
                "-mno-red-zone",
                "-mno-sse",
                "-mno-mmx",
                "-mabi=sysv"
            ]
        }
    ],
    "version": 4
}
