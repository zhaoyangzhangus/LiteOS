{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "System: build target for QEMU",
            "type": "process",
            "command": "bash",
            "args": [
                "-lc",
                "make -f GNUmakefile esp BUILD=build DEBUG=2 OS_DEBUG_SERIAL=1 -j4"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\tools\\build-windows.ps1",
                    "-Build",
                    "build",
                    "-Debug",
                    "2",
                    "-Serial"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "BUILD": "build"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "System: start QEMU debug (auto)",
            "type": "process",
            "command": "bash",
            "args": [
                "-lc",
                "BUILD=build ./run-qemu.sh --debug --gdb-port 1234 --cpu 4"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\tools\\run-qemu-auto.ps1",
                    "-Debug",
                    "-GdbPort",
                    "1234",
                    "-Cpu",
                    "4",
                    "-Build",
                    "build"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "OS_DEBUG_PROTOCOL": "1",
                    "BUILD": "build"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "never",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": {
                "owner": "system-qemu-auto",
                "pattern": {
                    "regexp": "a^"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^QEMU_DEBUG_START\\s*$",
                    "endsPattern": "^QEMU_DEBUG_READY\\s*$"
                }
            }
        },
        {
            "label": "System: stop QEMU debug (auto)",
            "type": "process",
            "command": "bash",
            "args": [
                "-lc",
                "BUILD=build ./tools/stop-qemu-debug.sh"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\tools\\stop-qemu-auto-debug.ps1",
                    "-Build",
                    "build"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
